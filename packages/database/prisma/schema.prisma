generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  EVENT_MANAGER
  WAITER
  CASHIER
  STATION
  REVISION
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  pinHash   String
  role      Role     @default(WAITER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

enum EventStatus {
  DRAFT
  PREPARED
  TEST_MODE
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Event {
  id         String      @id @default(uuid())
  name       String
  organizer  String?
  location   String?
  startTime  DateTime?
  endTime    DateTime?
  timezone   String      @default("Europe/Vienna")
  status     EventStatus @default(DRAFT)
  testMode   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  categories ProductCategory[]
  products   Product[]
  stations   Station[]
  orders     Order[]
}

model Station {
  id        String   @id @default(uuid())
  name      String
  shortName String?
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

enum ProductAvailability {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  DISABLED
}

model Product {
  id              String              @id @default(uuid())
  name            String
  shortName       String?
  description     String?
  price           Int                 // in cents
  taxRate         Int                 @default(2000) // 20.00% = 2000
  color           String?
  sortOrder       Int                 @default(0)
  imageUrl        String?
  availability    ProductAvailability @default(AVAILABLE)
  
  categoryId      String?
  category        ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  targetStationId String?
  targetStation   Station?            @relation(fields: [targetStationId], references: [id], onDelete: SetNull)
  
  eventId         String
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  orderItems      OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @default(autoincrement())
  totalAmount Int         // in cents
  status      OrderStatus @default(PENDING)
  
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
  payments    Payment[]
}

enum PaymentMethod {
  CASH
  CARD
  VOUCHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid())
  amount      Int           // in cents
  method      PaymentMethod
  status      PaymentStatus @default(COMPLETED)
  
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id          String          @id @default(uuid())
  quantity    Int
  priceAtTime Int             // in cents, snapshot of product price
  status      OrderItemStatus @default(PENDING)
  
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

model Printer {
  id              String      @id @default(uuid())
  name            String
  type            String      // e.g., 'CONSOLE', 'LAN', 'USB'
  ipAddress       String?
  port            Int?
  isActive        Boolean     @default(true)
  jobs            PrintJob[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PrintJob {
  id              String          @id @default(uuid())
  printerId       String
  printer         Printer         @relation(fields: [printerId], references: [id])
  content         Json            // The data payload for the printed ticket
  status          PrintJobStatus  @default(PENDING)
  orderId         String?         // Optional reference to the order
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

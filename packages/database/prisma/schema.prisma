generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  EVENT_MANAGER
  WAITER
  CASHIER
  STATION
  RUNNER
  REVISION
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  pinHash   String
  role      Role     @default(WAITER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]          @relation("OrderCreator")
  deliveryOrders    Order[]          @relation("OrderRunner")
  auditLogs         AuditLog[]
  cashierSessions   CashierSession[]
  issuedVouchers    ProductVoucher[] @relation("VoucherIssuer")
  // Druckauftraege, deren unklarer Ausgang von dieser Person entschieden wurde
  resolvedPrintJobs PrintJob[]       @relation("PrintJobResolver")
}

model AuthThrottle {
  key            String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

enum EventStatus {
  DRAFT
  PREPARED
  TEST_MODE
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// Once operational data has been recorded, its origin must never be inferred
// from an event's later state.  This makes test-data cleanup provably scoped.
enum OperationalDataMode {
  TEST
  LIVE
}

model Event {
  id        String      @id @default(uuid())
  name      String
  organizer String?
  location  String?
  startTime DateTime?
  endTime   DateTime?
  timezone  String      @default("Europe/Vienna")
  status    EventStatus @default(DRAFT)
  testMode  Boolean     @default(false)

  rksvConfirmedAt       DateTime?
  rksvConfirmedByUserId String?
  rksvDisclaimerVersion String?   @default("1.0")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories      ProductCategory[]
  products        Product[]
  stations        Station[]
  orders          Order[]
  areas           Area[]
  cashierSessions CashierSession[]
  productVouchers ProductVoucher[]
  // Je Betriebsart ein Zaehler fuer die Abholnummer (Issue #66).
  pickupCounters  EventPickupCounter[]
}

model Area {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  // Versionierter, serverseitig validierter Raumplan. Koordinaten liegen in
  // einer festen 1000x700-Arbeitsflaeche und bleiben dadurch auf allen
  // Bildschirmgroessen ohne Datenumrechnung skalierbar (Issue #138).
  floorPlan Json?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id        String  @id @default(uuid())
  name      String
  shortName String?
  color     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  printerId String?
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Produkte, die abweichend von ihrer Kategorie an diese Station gehen.
  products         Product[]
  // Warengruppen, deren Vorgabe diese Station ist.
  categories       ProductCategory[]
  redeemedVouchers ProductVoucher[]  @relation("VoucherRedemptionStation")
  // An dieser Station kassierte Verkaeufe (Stationskasse, Issue #66).
  stationSales     Order[]

  // Ermoeglicht zusammengesetzte Fremdschluessel, die die Veranstaltung
  // gemeinsam mit einer Stationsreferenz absichern (Issue #96).
  @@unique([id, eventId])
}

// Die Warengruppe traegt die Zielstation ihrer Produkte (Issue #84). Speisen
// gehen in die Kueche, Getraenke an die Schank; die Angabe wird einmal je
// Gruppe gepflegt statt an jedem Artikel wiederholt.
model ProductCategory {
  id        String @id @default(uuid())
  name      String
  sortOrder Int    @default(0)
  deposit   Int    @default(0) // in cents, Vorgabe fuer Produkte ohne eigenen Pfandbetrag
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Vorgabe-Zielstation der Warengruppe. Gilt fuer jedes Produkt der Gruppe,
  // das keine eigene Ausnahme traegt. NULL bedeutet zentrale Ausgabe.
  targetStationId String?
  targetStation   Station? @relation(fields: [targetStationId, eventId], references: [id, eventId], onDelete: SetNull, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  // Ermoeglicht, dass Produkte ihre Kategorie nur innerhalb derselben
  // Veranstaltung referenzieren (Issue #96).
  @@unique([id, eventId])
}

enum ProductAvailability {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  DISABLED
}

// Die Zielstation eines Produkts wird an genau einer Stelle aufgeloest
// (Issue #84): Station des Produkts, sonst Station der Kategorie, sonst
// zentrale Ausgabe. Das Backend darf diese Regel nicht mehrfach nachbauen.
model Product {
  id           String              @id @default(uuid())
  name         String
  shortName    String?
  description  String?
  price        Int // in cents
  deposit      Int                 @default(0) // in cents, Pfand je Einheit
  taxRate      Int                 @default(2000) // 20.00% = 2000
  color        String?
  sortOrder    Int                 @default(0)
  imageUrl     String?
  availability ProductAvailability @default(AVAILABLE)

  // Pflicht: ohne Warengruppe waere die Zielstation unbestimmt. Restrict statt
  // SetNull, weil eine Pflichtspalte nicht auf NULL gesetzt werden kann. Eine
  // Kategorie mit Produkten laesst sich damit erst nach dem Umhaengen loeschen.
  categoryId String
  category   ProductCategory @relation(fields: [categoryId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: NoAction)

  // Ausnahme von der Zielstation der Kategorie, nicht die Regel. NULL ist der
  // Normalfall und bedeutet: es gilt die Station der Kategorie. Ein Eintrag
  // hier weicht bewusst davon ab und ueberstimmt die Kategorie.
  targetStationId String?
  targetStation   Station? @relation(fields: [targetStationId, eventId], references: [id, eventId], onDelete: SetNull, onUpdate: NoAction)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]
  vouchers     ProductVoucher[]
}

// Anzahl der zulaessigen Antworten je Auswahlgruppe (Issue #75).
// SINGLE: hoechstens eine Antwort, MULTIPLE: beliebig viele im Rahmen von
// minSelect/maxSelect. Die Unterscheidung ist ausdrueckliches Stammdatum und
// wird nicht aus der Optionsanzahl erraten.
enum ProductOptionSelectionType {
  SINGLE
  MULTIPLE
}

// Preiswirkung einer Gruppe. ABSOLUTE ersetzt den Grundpreis des Produkts
// (Nachfolger von ProductVariant), SURCHARGE addiert auf den Grundpreis
// (Nachfolger von ProductExtra).
enum ProductOptionPriceMode {
  ABSOLUTE
  SURCHARGE
}

// Eine Auswahlgruppe gehoert immer genau einem Produkt. Wiederverwendbare
// Gruppen ueber mehrere Produkte hinweg sind ausdruecklich Nicht-Ziel.
//
// Nicht in Prisma abbildbar und deshalb nur in der SQL-Migration
// 20260821140000_add_product_option_groups vorhanden (dort im Kopfkommentar
// begruendet, spaetere Migrationen duerfen sie nicht stillschweigend
// entfernen):
//   - CHECK: sortOrder >= 0, Name nicht leer
//   - CHECK: minSelect >= 0, maxSelect >= 1 und maxSelect >= minSelect
//   - CHECK: isRequired = (minSelect >= 1)
//   - CHECK: SINGLE erzwingt maxSelect = 1 und minSelect <= 1
//   - CHECK: ABSOLUTE erzwingt SINGLE und isRequired
//   - CHECK: quickSaleTiles erzwingt SINGLE und isRequired
//   - UNIQUE (partiell): hoechstens eine ABSOLUTE-Gruppe je Produkt
//   - UNIQUE (partiell): hoechstens eine quickSaleTiles-Gruppe je Produkt
model ProductOptionGroup {
  id String @id @default(uuid())

  // Anzeigename der Frage, zum Beispiel "Groesse" oder "Beilage".
  name String

  // Einfach- oder Mehrfachauswahl.
  selectionType ProductOptionSelectionType

  // Pflicht oder freiwillig. Streng an minSelect gebunden:
  // isRequired ist genau dann wahr, wenn minSelect >= 1 ist.
  isRequired Boolean @default(false)

  // Mindestanzahl zu waehlender Optionen. 0 bedeutet freiwillig.
  minSelect Int @default(0)

  // Hoechstanzahl zu waehlender Optionen. NULL bedeutet unbegrenzt.
  // Bei SINGLE immer 1.
  maxSelect Int?

  // Wirkung der gewaehlten Option auf den Preis der Bestellposition.
  priceMode ProductOptionPriceMode @default(SURCHARGE)

  // Genau diese Gruppe faechert im Schnellverkauf in einzelne Kacheln auf.
  // Hoechstens eine Gruppe je Produkt darf die Marke tragen; traegt keine
  // Gruppe sie, zeigt der Schnellverkauf eine Kachel zum Produktgrundpreis.
  // Die Marke ist die einzige Quelle dieser Entscheidung; der Schnellverkauf
  // leitet sie nicht aus priceMode ab.
  quickSaleTiles Boolean @default(false)

  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  options ProductOption[]

  @@index([productId, sortOrder])
}

// Eine waehlbare Antwort innerhalb einer Auswahlgruppe.
//
// Nicht in Prisma abbildbar, nur in der SQL-Migration:
//   - CHECK: sortOrder >= 0, Name nicht leer
//   - CHECK: priceEffect zwischen -1000000 und 1000000 Cent
model ProductOption {
  id String @id @default(uuid())

  // Anzeigename der Antwort, zum Beispiel "0,5 l" oder "extra Sosse".
  name String

  // Preiswirkung in ganzen Cent, Betrag hoechstens 1000000.
  // Deutung haengt am priceMode der Gruppe: bei ABSOLUTE der Endpreis der
  // Position vor Aufpreisen, bei SURCHARGE der Aufpreis. Bei SURCHARGE sind
  // negative Werte erlaubt und bedeuten einen Abschlag ("ohne Beilage -2,00").
  // Bei ABSOLUTE muss der Wert nicht negativ sein; das kann eine zeilenweise
  // Bedingung nicht pruefen und wird in der Produktpflege erzwungen.
  priceEffect Int @default(0)

  // Voruebergehend nicht waehlbar, ohne die Option zu loeschen.
  // Bestehende Bestellungen bleiben davon unberuehrt.
  isActive Boolean @default(true)

  sortOrder Int @default(0)

  groupId String
  group   ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

enum OrderLifecycleStatus {
  SUBMITTED
  ACCEPTED
  PARTIALLY_CANCELLED
  CANCELLED
  COMPLETED
}

enum OrderFulfillmentStatus {
  PENDING
  PREPARING
  PARTIALLY_READY
  READY
  PARTIALLY_DELIVERED
  DELIVERED
}

enum OrderPaymentStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Order {
  id                 String                 @id @default(uuid())
  orderNumber        Int                    @default(autoincrement())
  totalAmount        Int // in cents
  depositRefundTotal Int                    @default(0) // in cents, verrechnetes Pfand
  lifecycleStatus    OrderLifecycleStatus   @default(SUBMITTED)
  paymentStatus      OrderPaymentStatus     @default(OPEN)
  fulfillmentStatus  OrderFulfillmentStatus @default(PENDING)
  isPriority         Boolean                @default(false)
  idempotencyKey     String?                @unique
  tableName          String?
  areaId             String?
  area               Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation("OrderCreator", fields: [userId], references: [id])

  claimedByUserId String?
  claimedBy       User?     @relation("OrderRunner", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedAt       DateTime?

  eventId  String
  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dataMode OperationalDataMode

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  vouchers ProductVoucher[]

  cashierSessionId String?
  cashierSession   CashierSession? @relation(fields: [cashierSessionId], references: [id])

  // Stationskasse (Issue #66). Beide Felder sind optional, weil jede
  // Bestellung aus der Bedienmaske, der Onlineannahme und der zentralen
  // Bonkasse sie nicht traegt; NULL heisst hier "kein Stationsverkauf".
  //
  // pickupNumber ist die je Veranstaltung und Betriebsart fortlaufende, laut
  // aufrufbare Abholnummer. Sie wird NICHT aus orderNumber abgeleitet: jene
  // ist eine globale SERIAL, also weder veranstaltungs- noch
  // betriebsartbezogen und wegen nextval ausserhalb der Transaktion
  // luecken behaftet. Vergeben wird sie ueber EventPickupCounter, siehe
  // apps/backend/src/common/pickup-number.ts.
  //
  // stationId wird bei geloeschter Station auf NULL gesetzt und nicht
  // mitgeloescht: eine bezahlte Bestellung darf eine Aenderung an der
  // Stationsverwaltung nicht mitreissen. Das entspricht jeder anderen
  // Station-Beziehung im Bestand (Product, ProductCategory, ProductVoucher).
  pickupNumber Int?
  stationId    String?
  station      Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@unique([eventId, dataMode, orderNumber])
  @@unique([eventId, dataMode, pickupNumber])
  @@index([eventId, fulfillmentStatus, areaId])
  @@index([eventId, dataMode])
  @@index([claimedByUserId])
}

enum PaymentMethod {
  CASH
  CARD
  VOUCHER
  REFUND
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  amount         Int // charged amount in cents
  tenderedAmount Int? // cash handed over in cents
  changeAmount   Int           @default(0) // returned cash in cents
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  cashierSessionId String?
  cashierSession   CashierSession? @relation(fields: [cashierSessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductVoucherStatus {
  ISSUED
  REDEEMED
  CANCELLED
}

model ProductVoucher {
  id     String               @id @default(uuid())
  code   String               @unique
  status ProductVoucherStatus @default(ISSUED)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  issuedByUserId String?
  issuedBy       User?   @relation("VoucherIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  cashierSessionId String?
  cashierSession   CashierSession? @relation(fields: [cashierSessionId], references: [id], onDelete: SetNull)

  issuedAt DateTime @default(now())

  redeemedAt          DateTime?
  redeemedAtStationId String?
  redeemedAtStation   Station?  @relation("VoucherRedemptionStation", fields: [redeemedAtStationId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([orderId])
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id            String          @id @default(uuid())
  quantity      Int
  paidQuantity  Int             @default(0)
  priceAtTime   Int // in cents, snapshot of product price + variant price + extras
  depositAtTime Int             @default(0) // in cents, snapshot of product deposit per unit
  status        OrderItemStatus @default(PENDING)

  // Momentaufnahme der Auswahl zum Bestellzeitpunkt. Die drei Spalten bleiben
  // mit Issue #75 unveraendert, damit Berichte, Stornos und der Bondruck
  // bestehende Zeilen ohne Datenwanderung weiterlesen koennen.
  //
  // variantId/variantName: die gewaehlte Option der ABSOLUTE-Gruppe, also die
  // Antwort, die den Grundpreis gesetzt hat. NULL, wenn das Produkt keine
  // ABSOLUTE-Gruppe hat.
  // extras: alle uebrigen gewaehlten Optionen als Array
  // [{ id, name, price }], price = priceEffect in Cent. Neue Zeilen duerfen
  // zusaetzlich groupId und groupName fuehren; Leser muessen beide Felder als
  // moeglicherweise fehlend behandeln.
  variantId   String?
  variantName String?
  extras      Json?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product          @relation(fields: [productId], references: [id])
  vouchers  ProductVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  PRINTED
  FAILED
  // Ergebnis unklar: es gibt kein Zeugnis darueber, ob Papier vorliegt.
  // Wartet auf eine ausdrueckliche Entscheidung eines Menschen, niemals auf
  // einen automatischen Zweitdruck.
  UNRESOLVED
  // Endgueltig von der Administration verworfen.
  CANCELLED
}

// Unterzustand eines Zustellversuchs, nur innerhalb von PROCESSING gesetzt.
// Die Phase ist das einzige Kriterium fuer den Umgang mit einer abgelaufenen
// Reservierung: CLAIMED bedeutet nachweislich kein gesendetes Byte und darf
// zurueck nach PENDING; DELIVERING und SPOOLED bedeuten offenen Ausgang und
// fuehren nach UNRESOLVED.
enum PrintAttemptPhase {
  CLAIMED
  DELIVERING
  // Nur bei CUPS_IPP: der Spooler hat den Auftrag angenommen. Annahme ist kein
  // Druck; der Beweis haengt an cupsJobId und cupsJobState.
  SPOOLED
}

// Fehlerklasse eines abgeschlossenen Zustellversuchs.
// NOT_PRINTED gilt nur, wenn nachweisbar kein einziges Byte den Druckerport
// erreicht hat. Alles ohne positives Abschlusszeugnis ist UNCLEAR.
enum PrintOutcomeClass {
  NOT_PRINTED
  PRINTED
  UNCLEAR
}

enum PrintJobType {
  STATION_TICKET
  PRODUCT_VOUCHER
  RECEIPT
  CASHIER_CLOSING
}

model Printer {
  id         String  @id @default(uuid())
  name       String
  // 'CONSOLE' (Simulator), 'ESC_POS_NETWORK' (LAN/WLAN) oder 'CUPS_IPP'
  // (CUPS-Warteschlange ueber IPP; ipAddress traegt den abweichenden CUPS-Host,
  // port die Vorgabe 631, queueName den Warteschlangennamen).
  type       String
  ipAddress  String?
  port       Int?
  isActive   Boolean @default(true)
  paperWidth Int     @default(80) // 58 oder 80 Millimeter
  codepage   String  @default("CP858") // Zeichensatz fuer Umlaute und Euro
  cutMode    String  @default("PARTIAL") // NONE, PARTIAL oder FULL
  copies     Int     @default(1)
  timeoutMs  Int     @default(5000) // Zeitlimit des Netzwerktransports
  // CUPS-Warteschlangenname; Pflicht bei 'CUPS_IPP', sonst null. Die Queue muss
  // eine Raw-Queue sein, weil der Worker fertige ESC/POS-Bytes liefert.
  queueName  String?

  // Ersatzdrucker fuer das einmalige Failover. Bewusst global und nicht
  // veranstaltungsbezogen (Entscheidung der Projektleitung zu Risiko R7).
  //
  // WAS DIE DATENBANK GARANTIERT: ausschliesslich die Selbstreferenzfreiheit
  // ueber die Pruefbedingung "Printer_fallback_not_self_check"
  // (fallbackPrinterId IS NULL OR fallbackPrinterId <> id) sowie die
  // referenzielle Integritaet des Fremdschluessels.
  //
  // WAS DIE DATENBANK NICHT GARANTIERT und deshalb im Backend geprueft werden
  // muss: (a) Kettenfreiheit - ein Zyklus A -> B -> A oder A -> B -> C -> A
  // ist auf Datenbankebene nicht ausschliessbar; der Ersatz des Ersatzes wird
  // nie verwendet, es findet genau ein Wechsel statt (failoverCount <= 1);
  // (b) dass der Zieldrucker isActive ist; (c) dass ein Simulator ('CONSOLE')
  // keinen Ersatzdrucker traegt.
  fallbackPrinterId   String?
  fallbackPrinter     Printer?  @relation("PrinterFallback", fields: [fallbackPrinterId], references: [id], onDelete: SetNull)
  fallbackForPrinters Printer[] @relation("PrinterFallback")

  // Betriebssicht auf den Drucker, damit ein weggeschalteter Drucker nicht
  // unsichtbar defekt bleibt.
  lastErrorCode String?
  lastErrorAt   DateTime?
  lastOkAt      DateTime? // letzter belegter Erfolg

  jobs             PrintJob[] @relation("PrintJobPrinter")
  activeJobs       PrintJob[] @relation("PrintJobActivePrinter")
  failoverFromJobs PrintJob[] @relation("PrintJobFailoverFrom")
  stations         Station[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// Pruefbedingungen, die Prisma NICHT abbilden kann.
//
// Die Migration 20260821120000_add_print_lease_and_failover legt zwei
// CHECK-Constraints auf dieser Tabelle an:
//   "PrintJob_failoverCount_range_check"  failoverCount BETWEEN 0 AND 1
//   "PrintJob_attemptPhase_status_check"  attemptPhase IS NULL OR status = 'PROCESSING'
// und eine auf "Printer":
//   "Printer_fallback_not_self_check"     fallbackPrinterId IS NULL OR fallbackPrinterId <> id
//
// Prisma kennt keine CHECK-Constraints und stellt sie im Schema nicht dar. Sie
// tragen die Invariante "genau ein Ersatzdruckerwechsel" und die Bindung der
// Versuchsphase an PROCESSING. Wer sie in einer spaeteren Migration entfernt,
// entfernt die Doppeldruck-Sicherung. Nicht wegmigrieren, sondern bei einer
// Aenderung ausdruecklich neu setzen.
model PrintJob {
  id           String         @id @default(uuid())
  // Urspruenglich vorgesehener Drucker. Bleibt beim Failover unveraendert.
  printerId    String
  printer      Printer        @relation("PrintJobPrinter", fields: [printerId], references: [id])
  jobType      PrintJobType   @default(STATION_TICKET)
  content      Json // The data payload for the printed ticket
  status       PrintJobStatus @default(PENDING)
  orderId      String? // Optional reference to the order; historic jobs may outlive the order.
  errorMessage String? // Fliesstext zur Diagnose, niemals Bon-Inhalte

  // --- Reservierung und Fencing (M2, M3) ---
  // Unterzustand innerhalb PROCESSING; ausserhalb PROCESSING immer null.
  attemptPhase    PrintAttemptPhase?
  // Fencing-Token der laufenden Reservierung. Jede Worker-Operation
  // (Phasenwechsel, Herzschlag, Ergebnismeldung) muss ihn mitfuehren und wird
  // ueber WHERE id = ? AND leaseId = ? abgesichert. Ein Zombie-Worker mit altem
  // Token wird abgewiesen.
  leaseId         String?
  // Ablauf der Reservierung, per Herzschlag verlaengert. Ersetzt die Nutzung
  // von updatedAt als Lease-Uhr; updatedAt wird von jedem Schreibvorgang
  // aufgefrischt und taugt dafuer nicht.
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime? // letztes Lebenszeichen des Workers
  attemptCount    Int                @default(0) // Zahl der begonnenen Zustellversuche

  // --- Ersatzdrucker (Uebergang 5) ---
  // Drucker des aktuellen Versuchs. null bedeutet: printerId gilt.
  activePrinterId String?
  activePrinter   Printer?  @relation("PrintJobActivePrinter", fields: [activePrinterId], references: [id], onDelete: SetNull)
  // Zahl der Ersatzdruckerwechsel. Invariante: 0 oder 1, projektweit, in jedem
  // Zustand. Genau eine Codestelle im Backend erhoeht diesen Wert.
  failoverCount   Int       @default(0)
  failoverAt      DateTime?
  failoverReason  String? // ausloesende Fehlerkennung

  failoverFromPrinterId String?
  failoverFromPrinter   Printer? @relation("PrintJobFailoverFrom", fields: [failoverFromPrinterId], references: [id], onDelete: SetNull)

  // --- Ergebnis des letzten Versuchs ---
  outcomeClass PrintOutcomeClass? // zuletzt ermittelte Fehlerklasse
  // Stabile Kennung, z. B. DNS_ERROR, CONNECTION_LOST, CUPS_JOB_ABORTED,
  // LEASE_EXPIRED, REPORT_LOST. Maschinenlesbare Ergaenzung zu errorMessage.
  errorCode    String?
  deliveredAt  DateTime? // Zeitpunkt des belegten Drucks

  // --- Unklarer Ausgang und Admin-Entscheidung (Abschnitt 6.2) ---
  unresolvedAt     DateTime?
  // TRANSPORT | LEASE_EXPIRED | REPORT_LOST | CUPS_ABORTED | CUPS_CANCELED
  unresolvedReason String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("PrintJobResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  // REPRINTED | CONFIRMED_PRINTED | DISCARDED
  resolution       String?

  // --- Nachweistraeger der Transporte ---
  cupsJobId    Int? // Auftragsnummer im Spooler; ohne sie kein Cancel-Job-Beweis
  cupsJobState String? // zuletzt beobachteter job-state (pending, processing, ...)
  // socket.bytesWritten im Moment des Scheiterns. 0 ist der Beweis, dass kein
  // Byte den Prozess verlassen hat; > 0 zerstoert diesen Gegenbeweis.
  bytesWritten Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt]) // Auswahl im Claim
  @@index([status, leaseExpiresAt]) // Reaper sucht abgelaufene Reservierungen
  @@index([activePrinterId])
  @@index([status, unresolvedAt]) // Admin-Liste "Unklare Druckauftraege"
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityId   String
  entityType String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details    Json?
  createdAt  DateTime @default(now())
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

model CashierSession {
  id              String        @id @default(uuid())
  startingBalance Int           @default(0) // in cents
  closingBalance  Int? // in cents
  status          SessionStatus @default(ACTIVE)
  startTime       DateTime      @default(now())
  endTime         DateTime?

  userId   String
  user     User                @relation(fields: [userId], references: [id])
  eventId  String
  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dataMode OperationalDataMode

  orders   Order[]
  payments Payment[]
  vouchers ProductVoucher[]

  @@index([eventId, dataMode])
}

// Zaehler der Abholnummer je Veranstaltung und Betriebsart (Issue #66).
//
// Eine eigene Zeile statt einer SERIAL, weil nur so ein abgebrochener Verkauf
// keine Luecke hinterlaesst: die Erhoehung wird beim Rollback mit
// zurueckgenommen, ein verbrauchtes nextval nicht. Am Tresen ist eine Luecke
// die Nummer, die nie aufgerufen wird.
//
// dataMode gehoert in den Primaerschluessel, damit Test- und Echtbetrieb
// getrennte Zaehlerstaende haben und beide bei 1 beginnen. Die Vergabe selbst
// steht in apps/backend/src/common/pickup-number.ts; sie ist die einzige
// Stelle, die diese Tabelle hochzaehlt.
model EventPickupCounter {
  eventId    String
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dataMode   OperationalDataMode
  lastNumber Int                 @default(0)
  updatedAt  DateTime            @updatedAt

  @@id([eventId, dataMode])
}

model ConfigOperation {
  id             String   @id @default(uuid())
  scopeId        String
  action         String
  idempotencyKey String
  payloadHash    String
  response       Json
  createdAt      DateTime @default(now())

  @@unique([scopeId, action, idempotencyKey])
}

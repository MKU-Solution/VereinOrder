generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  EVENT_MANAGER
  WAITER
  CASHIER
  STATION
  REVISION
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  pinHash   String
  role      Role     @default(WAITER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  auditLogs AuditLog[]
}

enum EventStatus {
  DRAFT
  PREPARED
  TEST_MODE
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Event {
  id         String      @id @default(uuid())
  name       String
  organizer  String?
  location   String?
  startTime  DateTime?
  endTime    DateTime?
  timezone   String      @default("Europe/Vienna")
  status     EventStatus @default(DRAFT)
  testMode   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  categories ProductCategory[]
  products   Product[]
  stations   Station[]
  orders     Order[]
  areas      Area[]
}

model Area {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id        String   @id @default(uuid())
  name      String
  shortName String?
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

enum ProductAvailability {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  DISABLED
}

model Product {
  id              String              @id @default(uuid())
  name            String
  shortName       String?
  description     String?
  price           Int                 // in cents
  taxRate         Int                 @default(2000) // 20.00% = 2000
  color           String?
  sortOrder       Int                 @default(0)
  imageUrl        String?
  availability    ProductAvailability @default(AVAILABLE)
  
  categoryId      String?
  category        ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  targetStationId String?
  targetStation   Station?            @relation(fields: [targetStationId], references: [id], onDelete: SetNull)
  
  eventId         String
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  variants        ProductVariant[]
  extras          ProductExtra[]
  orderItems      OrderItem[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  name      String
  price     Int      // price in cents (absolute price for this variant)
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductExtra {
  id        String   @id @default(uuid())
  name      String
  price     Int      @default(0) // additional cost in cents
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum OrderLifecycleStatus {
  SUBMITTED
  ACCEPTED
  PARTIALLY_CANCELLED
  CANCELLED
  COMPLETED
}

enum OrderFulfillmentStatus {
  PENDING
  PREPARING
  PARTIALLY_READY
  READY
  PARTIALLY_DELIVERED
  DELIVERED
}

enum OrderPaymentStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Order {
  id                String                 @id @default(uuid())
  orderNumber       Int                    @default(autoincrement())
  totalAmount       Int                    // in cents
  lifecycleStatus   OrderLifecycleStatus   @default(SUBMITTED)
  paymentStatus     OrderPaymentStatus     @default(OPEN)
  fulfillmentStatus OrderFulfillmentStatus @default(PENDING)
  isPriority        Boolean                @default(false)
  idempotencyKey    String?                @unique
  tableName         String?
  
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  
  eventId           String
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  items             OrderItem[]
  payments          Payment[]
}

enum PaymentMethod {
  CASH
  CARD
  VOUCHER
  REFUND
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid())
  amount      Int           // in cents
  method      PaymentMethod
  status      PaymentStatus @default(COMPLETED)
  
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id          String          @id @default(uuid())
  quantity    Int
  priceAtTime Int             // in cents, snapshot of product price + variant price + extras
  status      OrderItemStatus @default(PENDING)
  
  variantId   String?
  variantName String?
  extras      Json?           // Array of selected extras: [{ id, name, price }]
  
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

model Printer {
  id              String      @id @default(uuid())
  name            String
  type            String      // e.g., 'CONSOLE', 'LAN', 'USB'
  ipAddress       String?
  port            Int?
  isActive        Boolean     @default(true)
  jobs            PrintJob[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PrintJob {
  id              String          @id @default(uuid())
  printerId       String
  printer         Printer         @relation(fields: [printerId], references: [id])
  content         Json            // The data payload for the printed ticket
  status          PrintJobStatus  @default(PENDING)
  orderId         String?         // Optional reference to the order
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityId    String
  entityType  String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details     Json?
  createdAt   DateTime @default(now())
}

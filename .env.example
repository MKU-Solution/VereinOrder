# VereinOrder - Umgebungsvariablen für Produktion und Raspberry Pi Festbetrieb

# PostgreSQL Konfiguration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vereinorder_fest_geheim_2026
POSTGRES_DB=vereinorder

# Backend Konfiguration
DATABASE_URL=postgresql://postgres:vereinorder_fest_geheim_2026@postgres:5432/vereinorder?schema=public
JWT_SECRET=super_secret_jwt_key_fuer_festbetrieb_bitte_aendern_mindestens_32_zeichen
PORT=3000
BACKUP_DIR=/app/backups
# Aufbewahrung nativer PostgreSQL-Sicherungen (#67). Manuelle und Legacy-
# Sicherungen werden nicht automatisch gelöscht.
BACKUP_RETENTION_HOURLY_KEEP=24
BACKUP_RETENTION_DAILY_KEEP=14
BACKUP_RETENTION_EVENT_KEEP=3
# Unterhalb dieser freien Bytes wird vor dem ersten pg_dump abgebrochen.
BACKUP_MIN_FREE_BYTES=1073741824
# Zustandsverzeichnis ausserhalb der Datenbank (Wartungsmodus, #67).
# Muss ein eigenes Volume sein, damit der Wartungsmodus einen Neustart oder
# ein Neuanlegen des Containers ueberlebt.
STATE_DIR=/app/state
# Im Compose-Festbetrieb auf 1 gesetzt: kontrollierter Backend-Neustart nach
# Restore-Umschaltung oder Rücknahme.
RESTORE_EXIT_AFTER_SWAP=1
PRINT_WORKER_TOKEN=bitte_ein_eindeutiges_geheimes_worker_token_mit_32_zeichen_setzen

# Print-Worker Konfiguration
BACKEND_URL=http://backend:3000
# Auf 1 setzen, um jeden Drucker auf den Simulator zu lenken (Entwicklung, Schulung)
PRINT_FORCE_SIMULATOR=0
# Abfrageintervall der Druckwarteschlange in Millisekunden
PRINT_POLL_INTERVAL_MS=2500
# Zeitlimit fuer Netzwerkdrucker ohne eigenen Wert in Millisekunden
PRINT_TIMEOUT_MS=5000
# Adresse des CUPS-Dienstes auf dem Host fuer Drucker vom Typ CUPS_IPP.
# CUPS laeuft auf dem Raspberry Pi selbst, nicht im Container. host.docker.internal
# zeigt ueber das Docker-Gateway auf den Host, siehe docs/ops/druckerbetrieb.md
CUPS_BASE_URL=http://host.docker.internal:631
# Abfrageintervall des Auftragsstatus in der CUPS-Warteschlange in Millisekunden
PRINT_CUPS_POLL_MS=1000
# Maximale Wartezeit auf ein Enddruckergebnis bei CUPS in Millisekunden, z. B. bei
# leerem Papier, bevor der Auftrag als unklar eingestuft wird
PRINT_CUPS_WAIT_MS=120000

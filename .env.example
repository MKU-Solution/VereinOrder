# VereinOrder - Umgebungsvariablen für Produktion und Raspberry Pi Festbetrieb

# Host-Ports des Buendels (#185). Alle drei sind Vorgaben, keine
# Festlegungen: Sind sie auf dem Rechner belegt, laesst sich das Buendel hier
# umziehen, ohne docker-compose.yml zu aendern. Es sind ausschliesslich die
# Ports AM HOST - innerhalb des Buendels sprechen sich die Dienste weiter
# ueber ihre Dienstnamen an (BACKEND_URL=http://backend:3000).
# Die Datenbank bleibt in jedem Fall an 127.0.0.1 gebunden (#181); nur die
# Portnummer ist frei.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=80

# Namen der Docker-Volumes (#185). Im Regelbetrieb NICHT anfassen: Die
# Vorgaben sind die Namen, unter denen eine bestehende Installation ihre Daten
# findet und unter denen der Notfallweg in docs/ops/backup-recovery.md sie
# sucht. Ein geaenderter Name legt ein NEUES, LEERES Volume an.
#
# Sie sind nur aus einem Grund ueberhaupt steuerbar: Wer ein zweites Buendel
# auf demselben Rechner fahren will (Probeaufbau neben dem laufenden Fest),
# MUSS alle drei aendern. Sonst haengen beide Buendel dieselben Volumes ein,
# zwei PostgreSQL-Server arbeiten auf demselben Datenverzeichnis, und die
# Sperrdatei verhindert das ueber Containergrenzen hinweg nicht.
POSTGRES_DATA_VOLUME=vereinorder_postgres_data
BACKUP_DATA_VOLUME=vereinorder_backup_data
STATE_DATA_VOLUME=vereinorder_state_data

# Fassung der Abbilder aus der Registry (#200). Leer oder nicht gesetzt
# bedeutet "latest": der letzte Stand von "main", den die CI vollstaendig
# gruen gebaut hat. Eine Commit-SHA pinnt eine bestimmte Fassung - sinnvoll,
# wenn vor dem Fest bewusst ein geprueftes Abbild festgehalten werden soll.
VEREINORDER_VERSION=latest

# PostgreSQL Konfiguration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vereinorder_fest_geheim_2026
POSTGRES_DB=vereinorder

# Backend Konfiguration
#
# DATABASE_URL wirkt hier NICHT: docker-compose.yml setzt sie dem Dienst
# "backend" selbst aus POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB zusammen
# (kein Dienst dieses Buendels hat ein "env_file", und die Datei wird auch
# nicht per Volume-Substitution eingelesen). Ein hier gesetzter Wert kann
# also unbemerkt einem anderen Passwort widersprechen, ohne dass das je
# auffiele - deshalb bleibt die Zeile auskommentiert.
#
# Auch ausserhalb von Docker wird DIESE DATEI nicht gelesen: Die Prisma-CLI
# und die lokalen Tests nehmen packages/database/.env, das Backend liest
# ueberhaupt keine Umgebungsdatei ein. Die VARIABLE ist dort echt und noetig -
# nur eben aus der Umgebung oder aus packages/database/.env, nicht von hier.
# Ihre Bedeutung steht in docs/ops/umgebungsvariablen.md.
# DATABASE_URL=postgresql://postgres:vereinorder_fest_geheim_2026@postgres:5432/vereinorder?schema=public
# Signaturschluessel fuer die Anmeldetoken. Darf leer bleiben (#175): Fehlt
# der Wert, erzeugt das Backend beim ersten Start 32 Zufallsbytes, legt sie
# mit Dateirechten 0600 unter STATE_DIR ab und verwendet sie bei jedem
# weiteren Start wieder. Ein hier gesetzter Wert gewinnt immer.
# Achtung beim Aktualisieren einer bestehenden Installation, die bisher
# ohne gesetzten Wert lief: Beim naechsten Start entsteht ein neuer
# Schluessel, alle ausgegebenen Token werden ungueltig und jedes Geraet muss
# sich neu anmelden. Vor der Veranstaltung aktualisieren, nicht waehrend.
JWT_SECRET=
PORT=3000
BACKUP_DIR=/app/backups
# Aufbewahrung nativer PostgreSQL-Sicherungen (#67). Manuelle und Legacy-
# Sicherungen werden nicht automatisch gelöscht.
BACKUP_RETENTION_HOURLY_KEEP=24
BACKUP_RETENTION_DAILY_KEEP=14
BACKUP_RETENTION_EVENT_KEEP=3
# Unterhalb dieser freien Bytes wird vor dem ersten pg_dump abgebrochen.
BACKUP_MIN_FREE_BYTES=1073741824
# Zustandsverzeichnis ausserhalb der Datenbank (Wartungsmodus, #67).
# Muss ein eigenes Volume sein, damit der Wartungsmodus einen Neustart oder
# ein Neuanlegen des Containers ueberlebt.
STATE_DIR=/app/state
# Im Compose-Festbetrieb auf 1 gesetzt: kontrollierter Backend-Neustart nach
# Restore-Umschaltung oder Rücknahme.
RESTORE_EXIT_AFTER_SWAP=1
# Gemeinsames Geheimnis zwischen Backend und Print-Worker. Darf ebenfalls
# leer bleiben (#175): Das Backend erzeugt es beim ersten Start unter
# STATE_DIR, der Worker liest dieselbe Datei ueber dasselbe Volume. Ein hier
# gesetzter Wert gewinnt und wird an beide Dienste gereicht; er muss dann
# mindestens 32 Zeichen haben.
PRINT_WORKER_TOKEN=

# Print-Worker Konfiguration
BACKEND_URL=http://backend:3000
# Auf 1 setzen, um jeden Drucker auf den Simulator zu lenken (Entwicklung, Schulung)
PRINT_FORCE_SIMULATOR=0
# Abfrageintervall der Druckwarteschlange in Millisekunden
PRINT_POLL_INTERVAL_MS=2500
# Zeitlimit fuer Netzwerkdrucker ohne eigenen Wert in Millisekunden
PRINT_TIMEOUT_MS=5000
# Adresse des CUPS-Dienstes auf dem Host fuer Drucker vom Typ CUPS_IPP.
# CUPS laeuft auf dem Raspberry Pi selbst, nicht im Container. host.docker.internal
# zeigt ueber das Docker-Gateway auf den Host, siehe docs/ops/druckerbetrieb.md
CUPS_BASE_URL=http://host.docker.internal:631
# Abfrageintervall des Auftragsstatus in der CUPS-Warteschlange in Millisekunden
PRINT_CUPS_POLL_MS=1000
# Maximale Wartezeit auf ein Enddruckergebnis bei CUPS in Millisekunden, z. B. bei
# leerem Papier, bevor der Auftrag als unklar eingestuft wird
PRINT_CUPS_WAIT_MS=120000
